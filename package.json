{
  "name": "ruyi-discord-bot",
  "module": "dist/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "start": "bun dist/main.js"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/luxon": "^3.7.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "^0.11.6",
    "discord.js": "^14.26.4",
    "luxon": "^3.7.2",
    "mathjs": "^15.2.0",
    "mongoose": "^9.6.1",
    "openai": "^6.39.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.1"
  }
}
