{
  "name": "ruyi-discord-bot",
  "module": "dist/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "test": "bun test",
    "steam:token": "bun scripts/get-steam-refresh-token.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "start": "bun dist/main.js"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/jsdom": "^28.0.3",
    "@types/luxon": "^3.7.1",
    "@types/steam-user": "^5.1.1",
    "@types/steamcommunity": "^3.50.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@openai/agents": "^0.11.6",
    "@smithery/api": "^0.67.0",
    "@tanstack/store": "^0.11.0",
    "@vvo/tzdb": "^6.198.0",
    "discord.js": "^14.26.4",
    "jsdom": "^29.1.1",
    "luxon": "^3.7.2",
    "mathjs": "^15.2.0",
    "mongoose": "^9.6.1",
    "openai": "^6.39.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0",
    "steamcommunity": "^3.50.0",
    "zod": "^4.4.1"
  }
}
